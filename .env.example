# ══════════════════════════════════════════════════
# Roots Nordic — Environment Variables
# Copy this file to .env and fill in real values.
# ══════════════════════════════════════════════════

# ── App ──────────────────────────────────────────
# Public URL where the Next.js frontend is served
NEXT_PUBLIC_SITE_URL=http://localhost:3004
# Browser API base: same-origin proxy (default `/api`) or full URL e.g. https://site/api
NEXT_PUBLIC_API_URL=/api
# Next.js server only: direct Hono URL for /api → backend proxy (local dev)
API_BACKEND_URL=http://127.0.0.1:4000
# Must match NEXT_PUBLIC_SITE_URL (used for CORS allow-origin)
CORS_ORIGIN=http://localhost:3004
# "development" | "production"
NODE_ENV=development
# Port the API server listens on (default: 4000)
PORT=4000

# ── Database ─────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roots

# ── Redis ────────────────────────────────────────
# Redis connection string (sessions, rate limiting, caching)
REDIS_URL=redis://localhost:6379
# Set to "true" to disable Redis (sessions fall back gracefully)
REDIS_DISABLED=false

# ── Auth / Security ─────────────────────────────
# Random 64+ char secret used for session HMAC signing
SESSION_SECRET=change-me-to-a-random-64-char-string
# Random secret used for CSRF token generation
CSRF_SECRET=change-me-to-another-random-string

# ── AI (OpenAI) ──────────────────────────────────
# OpenAI API base URL (default: https://api.openai.com)
OPENAI_BASE_URL=https://api.openai.com
# Your OpenAI API key
OPENAI_API_KEY=sk-proj-REPLACE-ME
# Default chat model
OPENAI_DEFAULT_MODEL=gpt-5.4-mini
# Vision model for hair analysis (needs multimodal support)
OPENAI_VISION_MODEL=gpt-5.4-mini
# Timeout in ms for hair analysis API calls (default: 120000)
OPENAI_HAIR_ANALYSIS_TIMEOUT_MS=120000
# Timeout in ms for MCP calls (default: 10000)
OPENAI_MCP_TIMEOUT_MS=10000

# ── Fortnox ──────────────────────────────────────
# Set to "true" to enable Fortnox integration
FORTNOX_ENABLED=false
# OAuth client credentials from Fortnox developer portal
FORTNOX_CLIENT_ID=stub
FORTNOX_CLIENT_SECRET=stub
FORTNOX_REDIRECT_URI=http://localhost:4000/v1/integrations/fortnox/callback
# 32-byte hex key for encrypting stored Fortnox tokens
FORTNOX_ENCRYPTION_KEY=change-me-32-byte-hex-key
# Webhook signature secret (required in production)
FORTNOX_WEBHOOK_SECRET=

# ── Klarna ───────────────────────────────────────
# Klarna API credentials for checkout integration
KLARNA_USERNAME=
KLARNA_PASSWORD=
# "playground" | "production"
KLARNA_ENV=playground

# ── BankID ───────────────────────────────────────
# Path to BankID PFX certificate file
BANKID_PFX_PATH=
# Passphrase for the PFX certificate
BANKID_PFX_PASSPHRASE=

# ── Email (Resend) ───────────────────────────────
# Resend API key for transactional emails
RESEND_API_KEY=
# "From" address for outgoing emails
RESEND_FROM_ADDRESS=noreply@roots.se
# Recipient for contact form submissions
CONTACT_FORM_EMAIL=info@roots.se

# ── Analytics ────────────────────────────────────
# Plausible domain (omit to disable analytics)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
