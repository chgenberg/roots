# ══════════════════════════════════════════════════
# Roots Nordic — Environment Variables
# Copy this file to .env and fill in real values.
#
# Legend
#   [REQUIRED-PROD]    — API process refuses to start in production if missing or placeholder
#   [RECOMMENDED-PROD] — feature degrades cleanly if missing; warned at boot
#   [OPTIONAL]         — dev/local toggles or off-by-default integrations
#
# Boot-time validator: apps/api/src/lib/validate-env.ts
# ══════════════════════════════════════════════════

# ── App ──────────────────────────────────────────
# [REQUIRED-PROD] Public URL where the Next.js frontend is served.
# Used in Klarna redirects, email links, OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3004
# [OPTIONAL] Browser API base: same-origin proxy (default `/api`) or full URL.
NEXT_PUBLIC_API_URL=/api
# [OPTIONAL] Next.js server only: direct Hono URL for /api → backend proxy (local dev).
API_BACKEND_URL=http://127.0.0.1:4000
# [REQUIRED-PROD] Must match NEXT_PUBLIC_SITE_URL — used for CORS allow-origin.
CORS_ORIGIN=http://localhost:3004
# [OPTIONAL] "development" | "production". Set to "production" on Railway/etc.
NODE_ENV=development
# [OPTIONAL] Port the API server listens on (default: 4000).
PORT=4000

# ── Database ─────────────────────────────────────
# [REQUIRED-PROD] PostgreSQL connection string. Use the pooled URL in prod.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roots
# [OPTIONAL] Set to "true" to run pending Drizzle migrations at API boot.
# Recommended for Railway (single-instance). Skip for multi-instance setups
# where migrations should run as a separate release step.
RUN_MIGRATIONS_ON_BOOT=false
# [OPTIONAL] Statement-level lock timeout for the boot migration in ms.
MIGRATE_LOCK_TIMEOUT_MS=60000

# ── Redis ────────────────────────────────────────
# [REQUIRED-PROD] Redis connection (sessions, rate-limit, CSRF nonce cache).
REDIS_URL=redis://localhost:6379
# [OPTIONAL] Set to "true" to disable Redis. Sessions fall back to memory.
# DO NOT enable in production — sessions then can't survive a redeploy.
REDIS_DISABLED=false

# ── Auth / Security ─────────────────────────────
# [REQUIRED-PROD] Random 64+ char secret used as HMAC base for signed
# tokens (account-deletion cancel link, order-view share link). The
# session cookie itself stores an opaque UUID in Redis, not a signed
# payload, so this value is NOT used for session integrity — see
# session.ts for the session implementation.
# (P3.53 audit 2026-05-26: tidigare beskrev kommentaren detta som
# "session HMAC" vilket var missvisande.)
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-64-char-string
# [REQUIRED-PROD] Random secret used for CSRF token HMAC.
# Generate with: openssl rand -hex 32
CSRF_SECRET=change-me-to-another-random-string
# [REQUIRED-PROD] HMAC secret used for the signed account-deletion
# cancel link sent in the goodbye email. Falls back to SESSION_SECRET
# om denna inte är satt, men vi vill ha en dedikerad nyckel i prod
# så att rotation av en inte invaliderar den andra. (P3.52)
# Generate with: openssl rand -hex 32
DELETION_TOKEN_SECRET=change-me-deletion-token-hmac
# [OPTIONAL] HMAC secret used for the public order-view share link.
# Same fallback-behaviour as DELETION_TOKEN_SECRET. (P3.52)
ORDER_VIEW_TOKEN_SECRET=change-me-order-view-hmac
# [OPTIONAL] Set to "true" to keep the seeded demo accounts loginable in prod.
# Required for investor demos on the staging URL.
ROOTS_ENABLE_DEMO_ACCOUNTS=false
# [REQUIRED-PROD unless PREVIEW_GATE_DISABLED=true] Lösenord till pre-
# launch/staging-gaten i Next.js middleware. Måste vara minst 12 tecken
# och får inte vara en känd default. (P3.52)
SITE_PREVIEW_PASSWORD=
# [OPTIONAL] Sätt till "true" för att helt stänga av preview-gaten
# (t.ex. när vi lanserar publikt). Default: gaten är på i prod.
PREVIEW_GATE_DISABLED=false

# ── Internal cron / job protection ──────────────
# [REQUIRED-PROD] Bearer-token som Railway/GH Actions måste skicka för
# att få anropa /v1/internal/cron/*. timing-safe-jämförelse + rate-
# limit ovanpå men hemligheten är första försvaret. (P3.52)
# Generate with: openssl rand -hex 32
INTERNAL_CRON_TOKEN=

# ── Operations kill switches ────────────────────
# [OPTIONAL] Master-switch för alla AI-features (chatt, hair-analysis,
# coach-suggestions). Sätts till "false" vid incident → API returnerar
# fallback-svar utan att anropa OpenAI. Default: "true" om OPENAI_API_KEY
# är satt. (P5.10 audit 2026-05-26)
AI_ENABLED=true

# ── AI (OpenAI) ──────────────────────────────────
# [RECOMMENDED-PROD] Missing → Open Claw assistant + hair-analysis disabled.
# [OPTIONAL] OpenAI API base URL (default: https://api.openai.com).
OPENAI_BASE_URL=https://api.openai.com
# [RECOMMENDED-PROD] Your OpenAI API key.
OPENAI_API_KEY=sk-proj-REPLACE-ME
# [OPTIONAL] Default chat model.
OPENAI_DEFAULT_MODEL=gpt-5.4-mini
# [OPTIONAL] Vision model for hair analysis (needs multimodal support).
OPENAI_VISION_MODEL=gpt-5.4-mini
# [OPTIONAL] Timeout in ms for hair analysis API calls (default: 120000).
OPENAI_HAIR_ANALYSIS_TIMEOUT_MS=120000
# [OPTIONAL] Timeout in ms for Open Claw MCP calls (default: 10000).
OPENAI_MCP_TIMEOUT_MS=10000

# ── Fortnox ──────────────────────────────────────
# [OPTIONAL] Set to "true" to enable Fortnox invoicing integration.
FORTNOX_ENABLED=false
# [OPTIONAL] OAuth client credentials from Fortnox developer portal.
FORTNOX_CLIENT_ID=stub
FORTNOX_CLIENT_SECRET=stub
FORTNOX_REDIRECT_URI=http://localhost:4000/v1/integrations/fortnox/callback
# [OPTIONAL] 32-byte hex key for encrypting stored Fortnox tokens.
FORTNOX_ENCRYPTION_KEY=change-me-32-byte-hex-key
# [RECOMMENDED-PROD] HMAC secret for Fortnox webhook signatures.
# Without it we cannot verify webhook authenticity → integration off in prod.
FORTNOX_WEBHOOK_SECRET=
# [OPTIONAL] OAuth access token (set by the OAuth callback; not user-edited).
FORTNOX_ACCESS_TOKEN=

# ── Klarna ───────────────────────────────────────
# [OPTIONAL] Klarna API credentials for checkout integration.
KLARNA_USERNAME=
KLARNA_PASSWORD=
# [OPTIONAL] "playground" | "production"
KLARNA_ENV=playground
# [RECOMMENDED-PROD] HMAC secret for Klarna webhook signature verification.
# If unset, the route falls back to IP allowlist (KLARNA_WEBHOOK_IPS). One
# of the two MUST be set in production — checkout.ts fails closed otherwise.
KLARNA_WEBHOOK_SECRET=
# [OPTIONAL] Comma-separated Klarna webhook IPs. Used when KLARNA_WEBHOOK_SECRET is unset.
KLARNA_WEBHOOK_IPS=
# [OPTIONAL] Public API base used in Klarna's `push` URL.
API_URL=http://localhost:4000

# ── BankID ───────────────────────────────────────
# [OPTIONAL] Path to BankID PFX certificate file (omit to use the stub adapter).
BANKID_PFX_PATH=
# [OPTIONAL] Passphrase for the PFX certificate.
BANKID_PASSPHRASE=
# [OPTIONAL] "test" | "production"
BANKID_ENV=test

# ── Email (Resend) ───────────────────────────────
# [RECOMMENDED-PROD] Resend API key for transactional emails.
# Missing → contact-form and invite emails are no-ops.
RESEND_API_KEY=
# [OPTIONAL] "From" address for outgoing emails.
RESEND_FROM_ADDRESS=Roots <hej@roots.se>
# [OPTIONAL] Recipient for contact-form submissions.
CONTACT_FORM_EMAIL=hej@roots.se

# ── Observability ────────────────────────────────
# [RECOMMENDED-PROD] Sentry DSN for error tracking + alerts.
# Without it, uncaught errors only land in stdout. See
# apps/api/src/lib/sentry.ts — fail-open by design.
SENTRY_DSN=
# [OPTIONAL] Sentry environment tag. Falls back to NODE_ENV.
SENTRY_ENVIRONMENT=
# [OPTIONAL] Release identifier — typically ${gitSha}-${deployId}.
SENTRY_RELEASE=
# [OPTIONAL] Performance traces sample rate (0.0–1.0). Default: 0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
# [OPTIONAL] Pino log level: "trace" | "debug" | "info" | "warn" | "error".
LOG_LEVEL=info

# ── Background workers ───────────────────────────
# [OPTIONAL] Set to "true" to enable pg-boss producer connection at API boot.
# Required if any code path calls `enqueueJob()`. Workers themselves run in
# `apps/api/src/workers/` and are a separate process.
WORKERS_ENABLED=false
# [OPTIONAL] Run pg-boss in in-memory mode (tests only — never enable in prod).
WORKERS_INMEMORY=false

# ── Analytics ────────────────────────────────────
# [OPTIONAL] Plausible domain (omit to disable analytics).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
