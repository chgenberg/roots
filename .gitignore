*.pyc

# Lokala personfoto / oprocessat material — inte webbassets.
public/Personal/

# Genererad output — inte källkod.
scripts/roots-shots/out/
scripts/roots-walkthrough/out/
docs/**/_cache/

# Presentationerna byggs ur kollegans Master Source med
# docs/presentations/build_decks.py. Byggskripten versionshanteras, men varken
# den extraherade källtexten eller de färdiga filerna gör det.
docs/knowledge-os/_extract/
docs/presentations/_preview/
docs/presentations/*.pptx

# Väntelista-exporter innehåller personuppgifter (e-post) och ska aldrig
# checkas in. Kör `pnpm waitlist:export` för att generera dem lokalt.
exports/

# Databasdumpar från scripts/db-backup.sh. Innehåller hela kundregistret,
# inklusive minderåriga säljare och deras målsmän. Ska krypteras och lagras
# utanför både repot och Railway — se docs/runbooks/backup-restore.md.
backups/

# Ersättningsförslaget är ett förhandlingsunderlag och hör inte i ett repo som
# fler har tillgång till. Hela mappen, inte bara dokumenten: byggskriptet
# innehåller belopp och villkor i klartext, så att undanta bara .md och .pdf
# lämnade förhandlingsunderlaget kvar i diffen.
docs/ersattning/
apps/web/public/images/_archive-*/
