{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "PORT",
    "DATABASE_URL",
    "REDIS_URL",
    "SESSION_SECRET",
    "CSRF_SECRET",
    "CORS_ORIGIN",
    "API_BACKEND_URL",
    "API_URL",
    "NEXT_PUBLIC_*",
    "OPENAI_*",
    "STRIPE_*",
    "FORTNOX_*",
    "RESEND_*",
    "SENTRY_*",
    "BANKID_*",
    "SITE_PREVIEW_PASSWORD",
    "PREVIEW_GATE_DISABLED",
    "FEATURE_*",
    "ROOTS_*",
    "INTERNAL_CRON_TOKEN",
    "DELETION_TOKEN_SECRET",
    "ORDER_VIEW_TOKEN_SECRET",
    "RUN_MIGRATIONS_ON_BOOT",
    "MIGRATE_LOCK_TIMEOUT_MS",
    "API_PROXY_TIMEOUT_MS",
    "API_PROXY_AI_TIMEOUT_MS",
    "WORKERS_ENABLED",
    "SCHEDULER_DISABLED",
    "SKIP_TYPECHECK"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "test": {
      "outputs": []
    }
  }
}
