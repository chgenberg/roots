{
  "name": "@roots/db",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/seed.ts",
    "db:seed:demo": "tsx src/seed-demo.ts",
    "db:update:products": "tsx src/update-products.ts",
    "db:seed:masters": "tsx src/seed-masters/index.ts",
    "db:masters:extract": "tsx scripts/extract-master-csv.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@roots/contracts": "workspace:*",
    "drizzle-orm": "^0.39",
    "postgres": "^3.4",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.0.2",
    "drizzle-kit": "^0.30",
    "tsx": "^4.19",
    "typescript": "^5.7",
    "vitest": "^3.1.4",
    "xlsx": "^0.18.5"
  }
}
