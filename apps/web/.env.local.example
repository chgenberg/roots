# Kopiera till apps/web/.env.local för lokal utveckling:
#   cp apps/web/.env.local.example apps/web/.env.local
#
# Next.js läser INTE monorepots rot-.env, så variablerna som middleware och
# /api-proxyn behöver måste ligga här. Utan filen svarar sajten 503 med
# "Förhandsvisningen är felkonfigurerad" och inloggningen når inte API:et.
#
# I produktion sätts dessa per tjänst (Railway) — inte via den här filen.

# Förhandsvisningsgrinden kräver annars SITE_PREVIEW_PASSWORD.
PREVIEW_GATE_DISABLED=true

# Same-origin /api-proxyn och middleware:ns rollkontroll pratar med API:et.
API_BACKEND_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3004
