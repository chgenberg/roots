{
  "name": "@roots/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "dev:workers": "tsx watch --env-file-if-exists=../../.env src/workers/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "start:workers": "node dist/workers/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "env:check": "tsx src/scripts/preflight-env.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13",
    "@node-rs/argon2": "^2.0.2",
    "@roots/contracts": "workspace:*",
    "@roots/db": "workspace:*",
    "@sentry/node": "^10.53.1",
    "@trpc/server": "^11.0.0-rc.700",
    "drizzle-orm": "^0.39",
    "hono": "^4.7",
    "ioredis": "^5.10.1",
    "otpauth": "^9.5.0",
    "pg-boss": "^10.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4",
    "stripe": "^22.5.0",
    "superjson": "^2.2",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8.3",
    "tsx": "^4.19",
    "typescript": "^5.7",
    "vitest": "^3.1.4"
  }
}
